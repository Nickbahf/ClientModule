local LP = game:GetService("Players").LocalPlayer
local RS = game:GetService("ReplicatedStorage")

local LuckMod = RS.Modules.Gameplay.SharedLuckModule
local LuckModule = LuckMod and require(LuckMod)
if LuckModule then
    local old = LuckModule.GetPlayerLuckMult
    LuckModule.GetPlayerLuckMult = function(self, ...)
        local base = old and old(self, ...) or 1
        return base * 10
    end
    local old2 = LuckModule.GetServerLuck
    LuckModule.GetServerLuck = function(self, ...)
        local base = old2 and old2(self, ...) or 1
        return base * 10
    end
end

local IndexLuckMod = RS.Modules.Gameplay.SharedIndexLuckModule
local IndexLuckModule = IndexLuckMod and require(IndexLuckMod)
if IndexLuckModule then
    local old = IndexLuckModule.GetTotalBonus
    IndexLuckModule.GetTotalBonus = function(self, ...)
        local base = old and old(self, ...) or 0
        return base + 10
    end
    local old2 = IndexLuckModule.GetActiveMultiplier
    IndexLuckModule.GetActiveMultiplier = function(self, ...)
        local base = old2 and old2(self, ...) or 1
        return base * 10
    end
end

local RollMod = RS.Modules.Gameplay.ClientRollModule
local RollModule = RollMod and require(RollMod)
if RollModule then
    RollModule.WaitForRollEnd = function(self, ...) return true end
    RollModule.FakeMeteorUsed = true
end

local BossRollMod = RS.Modules.Gameplay.ClientBossRollModule
if BossRollMod then
    local m = require(BossRollMod)
    if type(m) == "table" and m.WaitForRollEnd then
        m.WaitForRollEnd = function(self, ...) return true end
    end
end

-- GUI
local gui = Instance.new("ScreenGui", LP:WaitForChild("PlayerGui"))
gui.Name = "HijackSafe"; gui.ResetOnSpawn = false
local fr = Instance.new("Frame", gui)
fr.Size = UDim2.new(0, 220, 0, 60); fr.Position = UDim2.new(0, 10, 0, 100)
fr.BackgroundColor3 = Color3.fromRGB(15, 15, 15); fr.BackgroundTransparency = 0.15; fr.BorderSizePixel = 0; fr.Active = true
local ti = Instance.new("TextLabel", fr)
ti.Size = UDim2.new(1, 0, 0, 22); ti.BackgroundTransparency = 1; ti.Text = "Hijack ACTIVE"
ti.TextColor3 = Color3.fromRGB(0, 255, 0); ti.Font = Enum.Font.GothamBold; ti.TextSize = 14
local st = Instance.new("TextLabel", fr)
st.Size = UDim2.new(1, 0, 0, 18); st.Position = UDim2.new(0, 0, 0, 22); st.BackgroundTransparency = 1
st.Text = "1000x Luck | 0s Roll | " .. (LuckModule and "OK" or "FAIL")
st.TextColor3 = Color3.fromRGB(200, 200, 200); st.Font = Enum.Font.Gotham; st.TextSize = 11
local ds = Instance.new("TextButton", fr)
ds.Size = UDim2.new(0, 50, 0, 20); ds.Position = UDim2.new(1, -55, 0, 38)
ds.Text = "CLOSE"; ds.BackgroundColor3 = Color3.fromRGB(180, 0, 0); ds.TextColor3 = Color3.new(1, 1, 1)
ds.Font = Enum.Font.GothamBold; ds.TextSize = 11; ds.BorderSizePixel = 0
ds.MouseButton1Click:Connect(function() gui:Destroy() end)

local drag, dstart, fstart
fr.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true; dstart = i.Position; fstart = fr.Position end
end)
fr.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
end)
game:GetService("UserInputService").InputChanged:Connect(function(i)
    if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - dstart; fr.Position = UDim2.new(0, fstart.X.Offset + d.X, 0, fstart.Y.Offset + d.Y)
    end
end)
